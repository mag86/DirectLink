{
  "name": "directlink",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"cross-env VITE_DEV_SERVER_URL=http://localhost:5180 vite dev --host --port 5180 --strictPort\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5180 wait-on http://localhost:5180 && electron .\"",
    "build": "vite build && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "dexie": "^3.2.5",
    "multicast-dns": "^7.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-qr-code": "^2.0.18",
    "simple-peer": "^9.11.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.41",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "wait-on": "^7.2.0",
    "electron": "^28.2.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.directlink.app",
    "productName": "DirectLink",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
